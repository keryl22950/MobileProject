rules_version = '2';
service cloud.firestore {
    match /databases/{database}/documents {

        function isSignedIn() { return request.auth != null; }

        function groupData(groupId) {
            return get(/databases/$(database)/documents/groups/$(groupId)).data;
        }

        function isGroupMember(groupId) {
            return isSignedIn() && request.auth.uid in groupData(groupId).memberIds;
        }

        function isGroupAdmin(groupId) {
            return isGroupMember(groupId) &&
                    (groupData(groupId).ownerId == request.auth.uid
                        || get(/databases/$(database)/documents/groups/$(groupId)/members/$(request.auth.uid)).data.role == 'admin');
        }

        match /groups/{groupId} {
            // Les clients déjà distribués cherchent encore les invitations dans groups.
            allow get, list: if isSignedIn();

            allow create: if isSignedIn()
                && request.resource.data.ownerId == request.auth.uid
                && request.resource.data.memberIds.size() == 1
                && request.auth.uid in request.resource.data.memberIds;

            function changedGroupFields() {
                return request.resource.data.diff(resource.data).affectedKeys();
            }

            function onlyAddsSelf() {
                return !(request.auth.uid in resource.data.memberIds)
                    && request.auth.uid in request.resource.data.memberIds
                    && request.resource.data.memberIds.hasAll(resource.data.memberIds)
                    && request.resource.data.memberIds.size() == resource.data.memberIds.size() + 1;
            }

            function onlyRemovesSelf() {
                return request.auth.uid in resource.data.memberIds
                    && !(request.auth.uid in request.resource.data.memberIds)
                    && resource.data.memberIds.hasAll(request.resource.data.memberIds)
                    && request.resource.data.memberIds.size() == resource.data.memberIds.size() - 1;
            }

            function transfersOwnership() {
                let nextOwner = request.resource.data.ownerId;
                return resource.data.ownerId == request.auth.uid
                    && onlyRemovesSelf()
                    && nextOwner in request.resource.data.memberIds
                    && getAfter(/databases/$(database)/documents/groups/$(groupId)/members/$(nextOwner)).data.role == 'creator'
                    && changedGroupFields().hasOnly(['memberIds', 'ownerId']);
            }

            allow update: if isSignedIn() && (
                (isGroupAdmin(groupId) && changedGroupFields().hasOnly(['name'])
                    && request.resource.data.name is string)
                || (changedGroupFields().hasOnly(['memberIds'])
                    && (onlyAddsSelf() || (resource.data.ownerId != request.auth.uid && onlyRemovesSelf())))
                || transfersOwnership());

            allow delete: if isSignedIn() && resource.data.ownerId == request.auth.uid
                && resource.data.memberIds == [request.auth.uid];

            match /members/{memberId} {
                function groupAfter() {
                    return getAfter(/databases/$(database)/documents/groups/$(groupId)).data;
                }

                allow read: if isGroupMember(groupId);
                allow create: if isSignedIn() && request.auth.uid == memberId
                    && memberId in groupAfter().memberIds
                    && (request.resource.data.role == 'participant'
                        || (request.resource.data.role == 'creator' && groupAfter().ownerId == memberId));
                allow update: if isGroupAdmin(groupId)
                    && memberId != groupData(groupId).ownerId
                    && memberId in groupData(groupId).memberIds
                    && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['role'])
                    && (request.resource.data.role in ['admin', 'participant']
                        || (request.resource.data.role == 'creator' && groupData(groupId).ownerId == request.auth.uid));
                allow delete: if isSignedIn() && request.auth.uid == memberId;
            }

            match /groupements/{groupementId} {
                allow read: if isGroupMember(groupId);
                allow create, update, delete: if isGroupAdmin(groupId);

                match /challenges/{challengeId} {
                    allow read: if isGroupMember(groupId);
                    allow create, update, delete: if isGroupAdmin(groupId);

                    // Objectif d'une période (événements dynamiques) : création seule, une fois.
                    match /periods/{periodId} {
                        allow read: if isGroupMember(groupId);
                        allow create: if isGroupMember(groupId) && request.resource.data.target is number;
                    }

                    match /periods/{periodId}/progress/{uid} {
                        allow read: if isGroupMember(groupId);
                        allow write: if isGroupMember(groupId) && request.auth.uid == uid;
                    }

                    match /periods/{periodId}/activities/{activityId} {
                        allow read: if isGroupMember(groupId);
                        allow create: if isGroupMember(groupId) && request.resource.data.userId == request.auth.uid;
                    }

                    match /cumulative/{uid} {
                        allow read: if isGroupMember(groupId);
                        allow write: if isGroupMember(groupId) && request.auth.uid == uid;
                    }
                }
            }

            match /messages/{messageId} {
                allow read: if isGroupMember(groupId);
                allow create: if isGroupMember(groupId) && request.resource.data.userId == request.auth.uid;
            }
        }

        // Annonces administrées via la console Firebase, jamais depuis le client.
        match /appReleases/{releaseId} {
            allow get: if isSignedIn();
            allow list, write: if false;
        }

        match /users/{uid} {
            allow read: if isSignedIn();
            allow create, update: if isSignedIn() && request.auth.uid == uid;
            allow delete: if false;

            match /friends/{friendId} {
                allow read, write: if isSignedIn() && request.auth.uid == uid;
            }

            match /stats/{statId} {
                allow read: if isSignedIn();
                allow write: if isSignedIn() && request.auth.uid == uid;
            }

            // Historique d'activités : privé pour l'instant (à ouvrir aux amis le jour du profil façon Strava).
            match /activities/{activityId} {
                allow read, write: if isSignedIn() && request.auth.uid == uid;
            }
        }
    }
}
